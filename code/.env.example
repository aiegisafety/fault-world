# 复制成 code/.env 并填入你自己的凭据。code/.env 已被 .gitignore 排除，绝不要提交。
# 端点必须以 /compatible-mode/v1 结尾（OpenAI 兼容接口）。
DASHSCOPE_BASE=https://<your-workspace>.<region>.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_KEY=sk-...

# 可选的备用端点：不同 key 的免费额度分开计，ENDPOINT=alt 时启用
ALT_BASE=
ALT_KEY=

# 可选：智谱直连（模型名加 zhipu: 前缀时使用）
ZHIPU_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_KEY=
